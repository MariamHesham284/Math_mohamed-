        function drawNumberLine(stepIdx) {
            const canvas = document.getElementById('numberline-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;

            ctx.clearRect(0, 0, w, h);

            const y = h / 2 + 10;
            ctx.beginPath();
            ctx.moveTo(30, y);
            ctx.lineTo(w - 30, y);
            ctx.strokeStyle = '#94A3B8';
            ctx.lineWidth = 3;
            ctx.stroke();

            ctx.fillStyle = '#94A3B8';
            ctx.beginPath(); ctx.moveTo(25, y); ctx.lineTo(35, y - 5); ctx.lineTo(35, y + 5); ctx.fill();
            ctx.beginPath(); ctx.moveTo(w - 25, y); ctx.lineTo(w - 35, y - 5); ctx.lineTo(w - 35, y + 5); ctx.fill();

            const minVal = -3, maxVal = 5;
            const mapX = (val) => 40 + ((val - minVal) / (maxVal - minVal)) * (w - 80);

            for (let v = minVal; v <= maxVal; v++) {
                const cx = mapX(v);
                ctx.beginPath();
                ctx.moveTo(cx, y - 6);
                ctx.lineTo(cx, y + 6);
                ctx.strokeStyle = '#64748B';
                ctx.lineWidth = 2;
                ctx.stroke();

                ctx.fillStyle = '#CBD5E1';
                ctx.font = '12px Tajawal';
                ctx.textAlign = 'center';
                ctx.fillText(v.toString(), cx, y + 24);
            }

            const x1 = mapX(1), x2 = mapX(4);
            ctx.beginPath();
            ctx.moveTo(x1, y - 15);
            ctx.lineTo(x2, y - 15);
            ctx.strokeStyle = '#9F7AEA';
            ctx.lineWidth = 6;
            ctx.stroke();
            ctx.beginPath(); ctx.arc(x1, y - 15, 6, 0, Math.PI * 2); ctx.fillStyle = '#9F7AEA'; ctx.fill();
            ctx.beginPath(); ctx.arc(x2, y - 15, 6, 0, Math.PI * 2); ctx.fillStyle = '#9F7AEA'; ctx.fill();
            ctx.fillText("X = [1, 4]", (x1 + x2) / 2, y - 25);

            const y1 = mapX(-2), y2 = mapX(2);
            ctx.beginPath();
            ctx.moveTo(y1, y + 35);
            ctx.lineTo(y2, y + 35);
            ctx.strokeStyle = '#6CA6C8';
            ctx.lineWidth = 6;
            ctx.stroke();
            ctx.beginPath(); ctx.arc(y1, y + 35, 6, 0, Math.PI * 2); ctx.fillStyle = '#0F172A'; ctx.strokeStyle = '#6CA6C8'; ctx.lineWidth = 3; ctx.fill(); ctx.stroke();
            ctx.beginPath(); ctx.arc(y2, y + 35, 6, 0, Math.PI * 2); ctx.fillStyle = '#0F172A'; ctx.strokeStyle = '#6CA6C8'; ctx.lineWidth = 3; ctx.fill(); ctx.stroke();
            ctx.fillText("Y = ]-2, 2[", (y1 + y2) / 2, y + 55);

            if (stepIdx === 1) {
                const ix1 = mapX(1), ix2 = mapX(2);
                ctx.fillStyle = 'rgba(52, 211, 153, 0.3)';
                ctx.fillRect(ix1, y - 25, ix2 - ix1, 65);
            } else if (stepIdx === 2) {
                const dx1 = mapX(2), dx2 = mapX(4);
                ctx.fillStyle = 'rgba(237, 137, 54, 0.3)';
                ctx.fillRect(dx1, y - 25, dx2 - dx1, 65);
            }
        }

