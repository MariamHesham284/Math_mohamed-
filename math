                audio.playCorrect();
                quizScore++;
                document.getElementById('quiz-score').innerText = quizScore;
                selectedBtn.className = "glass-card p-4 rounded-2xl border-2 border-mint bg-mint/20 text-right text-lg text-white transition-all flex items-center justify-between shadow-lg shadow-mint/20";
                document.getElementById(`opt-icon-${optIdx}`).innerHTML = '<i class="fa-solid fa-check text-mint"></i>';

                feedbackBox.className = "p-4 rounded-2xl mb-6 border border-mint/40 bg-mint/10 text-mint text-sm leading-relaxed block";
                feedbackBox.innerHTML = `<strong>إجابة صحيحة! 🎉</strong> أحسنت صنعاً.`;
            } else {
                audio.playWrong();
                selectedBtn.className = "glass-card p-4 rounded-2xl border-2 border-red-400 bg-red-400/20 text-right text-lg text-white transition-all flex items-center justify-between shadow-lg shadow-red-500/20";
                document.getElementById(`opt-icon-${optIdx}`).innerHTML = '<i class="fa-solid fa-xmark text-red-400"></i>';

                const correctBtn = document.getElementById(`quiz-opt-${q.correct}`);
                correctBtn.className = "glass-card p-4 rounded-2xl border-2 border-mint bg-mint/10 text-right text-lg text-white flex items-center justify-between";

                feedbackBox.className = "p-4 rounded-2xl mb-6 border border-red-400/40 bg-red-400/10 text-red-200 text-sm leading-relaxed block";
                feedbackBox.innerHTML = `<strong>إجابة خاطئة!</strong> الإجابة الصحيحة هي Option (${String.fromCharCode(65 + q.correct)}).`;
            }

            document.getElementById('quiz-explain-btn').classList.remove('hidden');
            document.getElementById('quiz-next-btn').classList.remove('hidden');
        }

        function toggleQuizExplanation() {
            audio.playHover();
            const q = QUIZ_QUESTIONS[quizIdx];
            const feedbackBox = document.getElementById('quiz-feedback-box');
            feedbackBox.innerHTML += `<div class="mt-3 pt-3 border-t border-white/10 text-slate-200"><strong>التوضيح:</strong> ${q.explanation}</div>`;
            renderMathInElement(feedbackBox, { delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}] });
        }

        function nextQuizQuestion() {
            audio.playHover();
            if (quizIdx + 1 < QUIZ_QUESTIONS.length) {
                loadQuizQuestion(quizIdx + 1);
            } else {
                showQuizResults();
            }
        }

        function showQuizResults() {
            document.getElementById('quiz-card').classList.add('hidden');
            const resCard = document.getElementById('quiz-results-card');
            resCard.classList.remove('hidden');

            document.getElementById('final-score-display').innerText = `${quizScore} / ${QUIZ_QUESTIONS.length}`;

            let rating = "ممتاز! أداء استثنائي 🌟";
            if (quizScore < 4) rating = "محاولة جيدة! ينصح بمراجعة الدروس مجدداً 📚";
            else if (quizScore < 6) rating = "أداء رائع جداً! استمر في التفوق 👍";
            document.getElementById('final-rating-text').innerText = rating;

            if (quizScore >= 4) {
                confetti({
                    particleCount: 120,
                    spread: 80,
                    origin: { y: 0.6 }
                });
            }
        }

        function restartQuiz() {
            audio.playHover();
            quizScore = 0;
            document.getElementById('quiz-score').innerText = 0;
            document.getElementById('quiz-results-card').classList.add('hidden');
            document.getElementById('quiz-card').classList.remove('hidden');
            loadQuizQuestion(0);
        }
    </script>
</body>
</html>
